    {
      "name": "CU-03 - Reservar Butacas",
      "item": [
        {
          "name": "Crear Reserva (Bloqueo 10 min - RN-01, RN-02, RN-03)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.compraId) {",
                  "    pm.environment.set('compra_id', jsonData.data.compraId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{cliente_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"funcionId\": 1,\n  \"butacaIds\": [7, 8]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        }
      ]
    },
    {
      "name": "CU-04 - Confirmar Compra y Pagar",
      "item": [
        {
          "name": "Pagar Compra Pendiente (RN-02, RN-09, RN-10, RN-11)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.entradas && jsonData.data.entradas.length > 0) {",
                  "    pm.environment.set('ticket_code', jsonData.data.entradas[0].codigoUnico);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{cliente_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodoPago\": \"Tarjeta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{compra_id}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{compra_id}}", "pay"]
            }
          }
        }
      ]
    },
