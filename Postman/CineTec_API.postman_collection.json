                 {
                     "name":  "CU-04 - Confirmar Compra y Pagar",
                     "item":  [
                                  {
                                      "name":  "Pagar Compra Pendiente (RN-02, RN-09, RN-10, RN-11)",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "var jsonData = pm.response.json();",
                                                                                    "if (jsonData.data \u0026\u0026 jsonData.data.entradas \u0026\u0026 jsonData.data.entradas.length \u003e 0) {",
                                                                                    "    pm.environment.set(\u0027ticket_code\u0027, jsonData.data.entradas[0].codigoUnico);",
                                                                                    "}"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   }
                                                    }
